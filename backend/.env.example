# Copy to backend/.env and fill in the keys you have.
# At least one provider key is required for AI features.

# --- Routing ---------------------------------------------------------------
# Primary provider: openrouter | openai | groq | gemini | anthropic | azure
LLM_PROVIDER=openrouter
# Tried in order when the primary fails (omit any you don't use)
LLM_FALLBACK_PROVIDERS=groq,openai,gemini,anthropic

# --- API keys --------------------------------------------------------------
# Comma-separate multiple keys of the same provider to enable rotation.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=            # alias for GEMINI_API_KEY
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=            # alias for ANTHROPIC_API_KEY

# Azure OpenAI (all three required to enable azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- Models (optional overrides) ------------------------------------------
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_PROVIDER=Groq
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_MODEL=claude-sonnet-4-5
AZURE_OPENAI_MODEL=
RESUME_FALLBACK_MODEL=openai/gpt-oss-120b

# --- App -------------------------------------------------------------------
# SECRET_KEY=
# DATABASE_URL=
